# ============================================
# Digital AELA Frontend Environment Variables
# ============================================
#
# Copy this file to .env for local development.
# Only variables prefixed with VITE_ are exposed to the Vite frontend bundle.
# Do not put private secrets in frontend environment variables.

# Required in production.
# Backend API base URL, including /api/v1.
# Local development example:
VITE_API_URL=http://localhost:5000/api/v1
#
# Production example:
# VITE_API_URL=https://your-backend-domain.com/api/v1

# Optional / legacy compatibility.
# Some older frontend code checks this variable for analytics exports.
# Prefer VITE_API_URL for new code.
VITE_API_BASE_URL=

# Optional.
# Use only publishable browser-safe keys here, never Stripe secret keys.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
